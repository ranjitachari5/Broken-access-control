# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Secure Access Control Platform Backend
# Copy this file to .env and fill in real values before running the server.
# NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
PROJECT_NAME=Secure Access Control Platform
DEBUG=True

# ── PostgreSQL (asyncpg driver) ───────────────────────────────────────────────
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://sacp_user:sacp_password@localhost:5432/sacp_db

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a secure key with:  openssl rand -hex 32
SECRET_KEY=your_super_secret_key_here_replace_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Blockchain / Ganache ──────────────────────────────────────────────────────
WEB3_PROVIDER_URI=http://127.0.0.1:7545
AUDIT_CONTRACT_ADDRESS=0x71C7656EC7ab88b098defB751B7401B5f6d8976F

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (pydantic list field)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
